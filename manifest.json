{
  "manifest_version": 3,
  "name": "Safari Sync",
  "short_name": "Safari Sync",
  "version": "6.0",
  "description": "Bidirectional local history sync between Safari and one active Chrome or Edge profile on macOS.",
  "homepage_url": "https://github.com/brycemcole/chrome-to-safari-sync",
  "author": "Bryce Cole",
  "permissions": [
    "history",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Safari Sync",
    "default_popup": "popup.html"
  }
}
