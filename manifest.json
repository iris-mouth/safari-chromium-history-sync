{
  "manifest_version": 3,
  "name": "Safari Chromium History Sync",
  "short_name": "History Sync",
  "version": "6.0",
  "description": "Bidirectional local history sync between Safari and one active Chrome or Edge profile on macOS.",
  "homepage_url": "https://github.com/iris-mouth/safari-chromium-history-sync",
  "author": "Bryce Cole and contributors",
  "permissions": [
    "history",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Safari Chromium History Sync",
    "default_popup": "popup.html"
  }
}
